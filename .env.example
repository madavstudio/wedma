# Public canonical URL. Optional on Vercel: its production URL is detected.
# Set this to the final HTTPS domain after assigning it in Vercel.
SITE_URL=

# Server-only. Never use a VITE_ prefix for these settings.
RESEND_API_KEY=
# An address on a domain verified in Resend, for example WEDMA <website@your-domain>
CONTACT_FROM=
# Optional origin restriction without trailing slash. Leave empty on Vercel
# to accept requests from the current deployment's own origin.
CONTACT_ORIGIN=
# Standalone local Node server only; do not set these on Vercel.
HOST=127.0.0.1
PORT=4173
